import tkinter as tk


class Point:
    def __init__(self):
        self.up = 0
        self.down = 0
        self.left = 0
        self.right = 0

    def move(self, key):
        if key == "Up":
            self.up += 1

        elif key == "Down":
            self.down += 1

        elif key == "Left":
            self.left += 1

        elif key == "Right":
            self.right += 1

        x = self.right - self.left
        y = self.up - self.down

        print("Нови координати:", x, y)

        return x, y



point = Point()


window = tk.Tk()
window.title("Движеща се точка")
window.geometry("600x600")


canvas = tk.Canvas(
    window,
    width=600,
    height=600,
    bg="pink"
)
canvas.pack()


screen_x = 300
screen_y = 300


circle = canvas.create_oval(
    screen_x - 5,
    screen_y - 5,
    screen_x + 5,
    screen_y + 5,
    fill="pink"
)


def move_point(event):
    global screen_x, screen_y


    x, y = point.move(event.keysym)

 
    screen_x = 300 + x * 20
    screen_y = 300 - y * 20

    canvas.coords(
        circle,
        screen_x - 5,
        screen_y - 5,
        screen_x + 5,
        screen_y + 5
    )



window.bind("<Up>", move_point)
window.bind("<Down>", move_point)
window.bind("<Left>", move_point)
window.bind("<Right>", move_point)

window.mainloop()

