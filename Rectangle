
class Rectangle:
    def __init__(self, x1, y1, x2, y2):
        self.x1 = min(x1, x2)
        self.y1 = min(y1, y2)
        self.x2 = max(x1, x2)
        self.y2 = max(y1, y2)

    def area(self):
        return (self.x2 - self.x1) * (self.y2 - self.y1)

    def perimeter(self):
        return 2 * ((self.x2 - self.x1) + (self.y2 - self.y1))

    def isOver(self, other):
        return not (
            self.x2 <= other.x1 or
            self.x1 >= other.x2 or
            self.y2 <= other.y1 or
            self.y1 >= other.y2
        )


